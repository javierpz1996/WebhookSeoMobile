# Misma configuración que `.env` del repo (listo para usar tras clonar).
# Groq y demás LLM están en el workflow n8n de esa URL, no en la app.

EXPO_PUBLIC_WEBHOOK_URL=https://javierpz8.app.n8n.cloud/webhook/article-studio-generate
EXPO_PUBLIC_WEBHOOK_TOKEN=
EXPO_PUBLIC_USE_GENERATION_STUB=false
EXPO_PUBLIC_USE_JSON_STORAGE=true
